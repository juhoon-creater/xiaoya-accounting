<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaoya.user.mapper.UserMapper">

    <!-- 按用户名统计用户数量，供注册前检查是否重名。 -->
    <select id="countByUsername" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE username = #{username}
    </select>
    <!-- 保存用户，并将数据库生成的主键回填到 user.id。 -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (username, password_hash, created_at)
        VALUES (#{username}, #{passwordHash}, #{createdAt})
    </insert>
    <!-- 将数据库列名映射到 User 实体属性。 -->
    <resultMap id="userResultMap" type="com.xiaoya.user.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <!-- 登录时按用户名查询用户，业务层随后会校验密码哈希。 -->
    <select id="selectByUsername" resultMap="userResultMap">
        SELECT id, username, password_hash, created_at
        FROM users
        WHERE username = #{username}
    </select>
    <!-- 查询当前用户资料，只取接口允许返回的公开字段。 -->
    <select id="selectById" resultMap="userResultMap">
        SELECT id, username, created_at
        FROM users
        WHERE id = #{id}
    </select>
</mapper>